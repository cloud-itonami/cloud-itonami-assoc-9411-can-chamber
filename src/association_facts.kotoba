    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-24")
    :else (option-none-of [:option :string])))

(defn entry-field-16 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "canadianchamber.membership-separate-from-local-chambers")
    (string=? f "title") (option-some-of [:option :string] "Membership in the Canadian Chamber is separate from membership in a local, regional or provincial/territorial chamber")
    (string=? f "association") (option-some-of [:option :string] "canadianchamber")
