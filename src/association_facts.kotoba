    (string=? f "source-article") (option-some-of [:option :string] "FAQ")
    (string=? f "source-quote") (option-some-of [:option :string] "Membership with the Canadian Chamber is separate from membership with a local, regional or provincial/territorial chamber.")
    (string=? f "date-unknown-because") (option-some-of [:option :string] "page-states-a-standing-arrangement")
    (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-24")
    :else (option-none-of [:option :string])))

(defn entry-field-17 [f :string] [:option :string]
  (cond
    (string=? f "id") (option-some-of [:option :string] "canadianchamber.icc-canada-national-committee")
    (string=? f "title") (option-some-of [:option :string] "The Chamber is Canada's National Committee of the International Chamber of Commerce and operates as ICC Canada")
